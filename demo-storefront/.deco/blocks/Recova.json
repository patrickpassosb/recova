{
  "__resolveType": "site/sections/Theme/Theme.tsx",
  "buttonStyle": {
    "--border-btn": "1px",
    "--rounded-btn": "99999px",
    "--btn-focus-scale": "1",
    "--animation-btn": "0.25s"
  },
  "font": {
    "__resolveType": "website/loaders/fonts/googleFonts.ts",
    "fonts": [
      {
        "variations": [
          { "weight": "400" },
          { "weight": "500" },
          { "weight": "600" },
          { "weight": "700" },
          { "weight": "800" }
        ],
        "family": "Manrope"
      },
      {
        "variations": [
          { "weight": "400" },
          { "weight": "500" },
          { "weight": "600" },
          { "weight": "700" }
        ],
        "family": "Inter"
      }
    ]
  },
  "colorScheme": "light",
  "otherStyles": {
