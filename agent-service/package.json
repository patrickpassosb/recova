{
  "name": "agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recova recovery agent service (Node 24 + TypeScript)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
