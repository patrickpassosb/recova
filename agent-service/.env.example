# Copy to agent-service/.env and fill in. .env is gitignored — never commit it.

# Gemini Developer API key from https://aistudio.google.com (free tier OK for dev)
GEMINI_API_KEY=

# Gemini model IDs — do NOT downgrade silently (hackathon compliance)
GEMINI_MODEL=gemini-3.7-flash
GEMMA_MODEL=gemma-4-31b-it

# Deterministic local test path. true in CI; false only for hosted/real-model runs
STUB_GEMINI=true

# GCP (only needed when credits/billing are active — release gate, not dev)
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_REGION=us-central1

# Shopify demo store binding for the `demo` merchant (real cart + checkout).
# Public Storefront API token for gimenesdevstore (public in repo history).
SHOPIFY_STOREFRONT_ENDPOINT=
SHOPIFY_STOREFRONT_TOKEN=
